include_guard(GLOBAL)

function(orbit_detect_livekit_host out_triple out_ext)
    if(WIN32)
        set(_os "windows")
        set(_ext "zip")
    elseif(APPLE)
        set(_os "macos")
        set(_ext "tar.gz")
    elseif(UNIX)
        set(_os "linux")
        set(_ext "tar.gz")
    else()
        message(FATAL_ERROR "Unsupported LiveKit C++ SDK host OS")
    endif()

    string(TOLOWER "${CMAKE_HOST_SYSTEM_PROCESSOR}" _proc)
    if(_proc MATCHES "^(x86_64|amd64)$")
        set(_arch "x64")
    elseif(_proc MATCHES "^(arm64|aarch64)$")
        set(_arch "arm64")
    else()
        message(FATAL_ERROR "Unsupported LiveKit C++ SDK host arch: ${CMAKE_HOST_SYSTEM_PROCESSOR}")
    endif()

    set(${out_triple} "${_os}-${_arch}" PARENT_SCOPE)
    set(${out_ext} "${_ext}" PARENT_SCOPE)
endfunction()

function(orbit_livekit_sdk_setup)
    set(oneValueArgs VERSION SDK_DIR DOWNLOAD_DIR)
    cmake_parse_arguments(LK "" "${oneValueArgs}" "" ${ARGN})

    if(NOT LK_VERSION)
        message(FATAL_ERROR "orbit_livekit_sdk_setup requires VERSION")
    endif()
    if(NOT LK_SDK_DIR)
        message(FATAL_ERROR "orbit_livekit_sdk_setup requires SDK_DIR")
    endif()
    if(NOT LK_DOWNLOAD_DIR)
        set(LK_DOWNLOAD_DIR "${CMAKE_BINARY_DIR}/_downloads")
    endif()

    orbit_detect_livekit_host(_triple _ext)
    set(_archive "livekit-sdk-${_triple}-${LK_VERSION}.${_ext}")
    set(_url "https://github.com/livekit/client-sdk-cpp/releases/download/v${LK_VERSION}/${_archive}")
    set(_archive_path "${LK_DOWNLOAD_DIR}/${_archive}")
    set(_root "${LK_SDK_DIR}/livekit-sdk-${_triple}-${LK_VERSION}")

    file(MAKE_DIRECTORY "${LK_DOWNLOAD_DIR}")
    file(MAKE_DIRECTORY "${LK_SDK_DIR}")

    if(NOT EXISTS "${_root}/lib/cmake/LiveKit")
        message(STATUS "Downloading LiveKit C++ SDK ${LK_VERSION} from ${_url}")
        file(DOWNLOAD "${_url}" "${_archive_path}" SHOW_PROGRESS TLS_VERIFY ON STATUS _status LOG _log)
        list(GET _status 0 _code)
        list(GET _status 1 _message)
        if(NOT _code EQUAL 0)
            message(STATUS "LiveKit C++ SDK download log:\n${_log}")
            message(FATAL_ERROR "LiveKit C++ SDK download failed: ${_message}")
        endif()

        file(REMOVE_RECURSE "${_root}")
        file(ARCHIVE_EXTRACT INPUT "${_archive_path}" DESTINATION "${LK_SDK_DIR}")
    endif()

    if(NOT EXISTS "${_root}/lib/cmake/LiveKit")
        message(FATAL_ERROR "LiveKit C++ SDK package is missing lib/cmake/LiveKit at ${_root}")
    endif()

    list(PREPEND CMAKE_PREFIX_PATH "${_root}")
    set(CMAKE_PREFIX_PATH "${CMAKE_PREFIX_PATH}" PARENT_SCOPE)
    set(LiveKit_DIR "${_root}/lib/cmake/LiveKit" PARENT_SCOPE)
    set(ORBIT_LIVEKIT_SDK_ROOT "${_root}" PARENT_SCOPE)
endfunction()

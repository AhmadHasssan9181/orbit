# The Matrix server name clients will use. With Tailscale this is your MagicDNS
# name, e.g. matrix.yak-bebop.ts.net — a valid Matrix server name, and
# `tailscale serve` gives it a real Let's Encrypt certificate, so there is no
# self-signed TLS problem anywhere in the stack.
SERVER_NAME=matrix.example.com

# A long random string. Used by `register_new_matrix_user --shared-secret` to
# create accounts without turning on open registration.
#   openssl rand -hex 32
REGISTRATION_SHARED_SECRET=<openssl rand -hex 32>

POSTGRES_USER=orbit
POSTGRES_PASSWORD=<openssl rand -base64 24>

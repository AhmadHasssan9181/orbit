.gradle/
.idea/
build/
**/build/
gradle-8.5/
*.iml
local.properties
.DS_Store

# Only the build's scratch archives are ignored, not every .zip in the tree:
# a blanket *.zip rule silently untracked real project resources.
**/build/jni/_downloads/*.zip
*.hprof
.kotlin/

# Orbit Audio JNI
orbit_audio_jni/out/
orbit_audio_jni/build/
orbit_audio_jni/.vs/
orbit_audio_jni/webrtc/

# Exclude DLLs by default, but include the ones bundled in app resources
*.dll
!app/src/jvmMain/resources/**/*.dll
!app/src/jvmMain/resources/*.dll
!app/src/jvmMain/resources/desktop/*.dll

# Crash dumps and test files
app/hs_err_pid*.log
test_*.cpp

# One-off debugging scratch files that live at the repo root
/ListMics.java
/ProbeMics.java
/ListMics.class
/ProbeMics.class
/scratch_test.kt
/fix_gif_crash.kt
*.old2
/build_baseline_test.log

# CMake / Visual Studio build caches.
#
# `**/build/` above does not reach these, because the generated directories are
# not always named "build" -- webrtc-jni uses build2, and orbit_audio_jni keeps a
# parallel out/ tree. 166 of these were tracked, each carrying absolute paths from
# whichever machine generated it, so every clone disagreed with the committed
# cache. They are now untracked; this stops them coming back.
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
LastTest.log
LastTestsFailed.log
Testing/
*.sln
*.vcxproj
*.vcxproj.filters
VSInheritEnvironments.txt
TargetDirectories.txt
VCTargetsPath.txt
compile_commands.json

# Stale editor/merge leftovers of a source file. *.old2 was already listed;
# these are the other names the same mistake turns up under.
*.old
*.bak
*.orig
*.rej
*~